---
import BaseLayout from "../layouts/BaseLayout.astro";
import Experience from "../components/Experience.astro";
import { profile, projects, skills } from "../data/resume";
---

<BaseLayout>
  <main id="portfolio">

    <section class="panel hero" id="intro" aria-label="Introduction">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="kicker">Senior QA Analyst · 15+ years in software testing</p>
          <h1>Axel Xavier<br /><em>Rolón.</em></h1>
          <p class="hero-summary">
            Testing complex systems, finding the problems that matter,
            and helping teams build software with confidence.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#resume">Explore my experience <span>↓</span></a>
            <a class="button button-ghost" href={`mailto:${profile.email}`}>Get in touch</a>
          </div>
        </div>

        <div class="hero-mark" aria-hidden="true">
          <div class="portrait-placeholder">
            <img src="/photo.jpg" alt="Axel Xavier Rolón" />
          </div>
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="orbit-label">QA / API / AUTOMATION</div>
        </div>
      </div>

      <footer class="hero-footer">
        <span>{profile.location}</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span>{profile.phone}</span>
      </footer>
    </section>

    <section class="panel resume" id="resume" aria-label="Resume">
      <div class="section-header">
        <div>
          <p class="kicker">02 / Career</p>
          <h2>Experience<br /><em>that compounds.</em></h2>
        </div>
        <p class="section-intro">{profile.summary}</p>
      </div>

      <div class="resume-content">
        <div class="skills-column">
          <p class="label">Core toolkit</p>
          <div class="skill-cloud">
            {skills.map((skill) => <span>{skill}</span>)}
          </div>

          <div class="languages">
            <p class="label">Languages</p>
            {profile.languages.map((language) => <p>{language}</p>)}
          </div>
        </div>

        <div class="career-column">
          <Experience />
        </div>
      </div>
    </section>

    <section class="panel portfolio" id="projects" aria-label="Portfolio">
      <div class="section-header portfolio-header">
        <div>
          <p class="kicker">03 / Selected work</p>
          <h2>Built to<br /><em>be explored.</em></h2>
        </div>
        <p class="section-intro">
          A place for practical QA engineering projects, automation experiments,
          API testing, performance work and future open-source contributions.
        </p>
      </div>

      <div class="project-grid">
        {projects.map((project, index) => (
          <a class="project-card" href={project.href} aria-label={`Open ${project.name}`}>
            <div class="project-number">0{index + 1}</div>
            <div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
            </div>
            <div class="project-bottom">
              <div class="tags">
                {project.stack.map((tag) => <span>{tag}</span>)}
              </div>
              <span class="arrow">↗</span>
            </div>
          </a>
        ))}
      </div>

      <div class="portfolio-footer">
        <p>Interested in the work?</p>
        <a class="button button-primary" href={`mailto:${profile.email}`}>Contact me ↗</a>
        <span class="availability">Spanish · English</span>
      </div>
    </section>

  </main>

  <nav class="section-nav" aria-label="Section navigation">
    <a href="#intro" class="nav-dot active" aria-label="Introduction"></a>
    <a href="#resume" class="nav-dot" aria-label="Resume"></a>
    <a href="#projects" class="nav-dot" aria-label="Portfolio"></a>
  </nav>

  <script>
    const sections = [...document.querySelectorAll<HTMLElement>(".panel")];
    const dots = [...document.querySelectorAll<HTMLAnchorElement>(".nav-dot")];

    let wheelLocked = false;

    const setActive = (index: number) => {
      dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visible) {
          const index = sections.indexOf(visible.target as HTMLElement);
          if (index >= 0) setActive(index);
        }
      },
      { threshold: [0.55] }
    );

    sections.forEach((section) => observer.observe(section));

    window.addEventListener(
      "wheel",
      (event) => {
        if (window.innerWidth < 700 || wheelLocked) return;

        const direction = event.deltaY > 0 ? 1 : -1;
        const current = sections.findIndex((section) => {
          const rect = section.getBoundingClientRect();
          return Math.abs(rect.top) < window.innerHeight * 0.35;
        });

        if (current === -1) return;

        event.preventDefault();
        const target = Math.max(0, Math.min(sections.length - 1, current + direction));

        if (target !== current) {
          wheelLocked = true;
          sections[target].scrollIntoView({ behavior: "smooth" });
          window.setTimeout(() => (wheelLocked = false), 850);
        }
      },
      { passive: false }
    );

    window.addEventListener("keydown", (event) => {
      if (!["ArrowDown", "ArrowUp", "PageDown", "PageUp"].includes(event.key)) return;
      if ((event.target as HTMLElement)?.matches("input, textarea")) return;

      event.preventDefault();

      const current = sections.findIndex((section) => {
        const rect = section.getBoundingClientRect();
        return Math.abs(rect.top) < window.innerHeight * 0.35;
      });

      const direction = event.key === "ArrowUp" || event.key === "PageUp" ? -1 : 1;
      const target = Math.max(0, Math.min(sections.length - 1, current + direction));

      sections[target]?.scrollIntoView({ behavior: "smooth" });
    });
  </script>
</BaseLayout>